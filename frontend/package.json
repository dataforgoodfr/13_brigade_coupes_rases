    "es-toolkit": "^1.52.0",
    "geo-coordinates-parser": "^1.7.4",
    "ky": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
