{
  "name": "bcr-frontend",
  "private": true,
  "version": "0.37.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:cloud": "vite --mode cloud",
    "dev:mock": "vite --mode mock",
    "dev:mock:win": "set VITE_MOCK=true && vite",
    "cleanup": "biome check --write --unsafe",
    "lint": "biome ci",
    "cleanup:tsc": "biome check --write && tsc",
    "build:ci": "vite build",
    "build": "tsc -b && vite build",
    "build:preview": "pnpm build && vite preview",
    "build:dev:preview": "pnpm build --mode development && vite preview",
    "preview": "vite preview",
    "test": "vitest --mode test",
    "test:unit": "vitest run --mode test --project unit",
    "test:browser": "vitest run --mode test --project browser",
    "test:debug": "vitest --inspect --no-file-parallelism",
    "coverage": "vitest run --mode test --coverage",
    "install:playwright": "pnpm exec playwright install chromium --with-deps",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "STORYBOOK=true storybook build",
    "gen:routes": "tsr generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
