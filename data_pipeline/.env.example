#S3_REGION = "S3_REGION"
#S3_ENDPOINT = "S3_ENDPOINT"
#AWS_ACCESS_KEY_ID = "AWS_ACCESS_KEY_ID"
#AWS_SECRET_ACCESS_KEY = "AWS_SECRET_ACCESS_KEY"
#S3_BUCKET_NAME = "S3_BUCKET_NAME"

DATABASE_URL=postgresql://user:password@host:5432/dbname

KEEPASS_PASSWORD= "KEEPASS_PASSWORD"

# Google Earth Engine (Python client). CLI is not global: from data_pipeline run
#   poetry run earthengine authenticate
# or: poetry run python -c "import ee; ee.Authenticate()"
# Then set:
# EARTH_ENGINE_PROJECT=your-gcp-project-id
# Enable "Earth Engine API" on that project in Google Cloud Console (works with non-commercial EE).
# Optional Google Cloud API key for EE client (passed as ee.Initialize(cloud_api_key=...); never commit real values):
# EARTH_ENGINE_CLOUD_API_KEY=
# (aliases: EARTH_ENGINE_API_KEY, GOOGLE_CLOUD_API_KEY)

# Optional: export RADD GeoTIFF via GCS then download (otherwise direct EE download).
# GCS_RADD_EXPORT_BUCKET=
# GCS_RADD_EXPORT_PREFIX=