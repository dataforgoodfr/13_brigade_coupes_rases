# Base de données cible (lue par run_pipeline.py et get_last_version.py)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object Storage Scaleway (lu par pipeline/scripts/utils/s3_utils.py)
# Les clés sont dans la base KeePass du projet (keepass/secrets.kdbx).
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET_NAME=brigade-coupe-rase-s3
S3_REGION=fr-par
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
