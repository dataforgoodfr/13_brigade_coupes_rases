# Base de données cible (lue par run_pipeline.py et get_last_version.py)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object Storage Scaleway (lu par pipeline/scripts/utils/s3_utils.py)
# Les clés sont dans la base KeePass du projet (keepass/secrets.kdbx).
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET_NAME=brigade-coupe-rase-s3
S3_REGION=fr-par
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# Google Earth Engine (lu par pipeline/scripts/get_sufosat_tiff.py)
# Projet Google Cloud avec l'API Earth Engine activée.
EARTH_ENGINE_PROJECT=...
# Sans navigateur (CI, tâche planifiée) : JSON complet, sur une ligne, de la clé
# d'un compte de service enregistré auprès d'Earth Engine ; prioritaire sur la
# connexion interactive (`poetry run earthengine authenticate`).
GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# Optionnel : export du raster RADD via un bucket Google Cloud Storage, puis
# téléchargement. Sans bucket, le raster est récupéré tuile par tuile
# (getDownloadURL), ce qui prend des heures.
# GCS_RADD_EXPORT_BUCKET=
# GCS_RADD_EXPORT_PREFIX=radd_exports
